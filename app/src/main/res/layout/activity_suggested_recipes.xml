<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".SuggestedRecipesActivity">

    <!-- Main Suggested Recipes screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cream">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:background="@color/sage"
            android:title="Smart Pantry Manager"
            android:titleTextColor="@color/white" />

        <!-- Fixed dark sage area behind the notification/status bar -->
        <View
            android:id="@+id/statusBarBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/sage_dark" />

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/cream"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@color/cream">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Suggested Recipes"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/brown"
                    android:gravity="center"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/recipeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking your pantry..."
                    android:textSize="16sp"
                    android:textColor="@color/brown_light"
                    android:gravity="center"
                    android:layout_marginBottom="28dp" />

                <!-- Recipes You Can Make -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recipes You Can Make"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown"
                    android:fontFamily="serif"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/recipeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="30dp" />

                <!-- Almost There -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Almost There"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown"
                    android:fontFamily="serif"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recipes missing only one ingredient"
                    android:textSize="15sp"
                    android:textColor="@color/brown_light"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/almostThereMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textSize="15sp"
                    android:textColor="@color/brown_light"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/almostThereList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp" />

                <Button
                    android:id="@+id/backButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/sage"
                    android:layout_marginBottom="35dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/cream"
        app:itemTextColor="@color/brown"
        app:itemIconTint="@color/sage"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>