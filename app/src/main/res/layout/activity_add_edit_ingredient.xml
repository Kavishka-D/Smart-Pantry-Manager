<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Dark sage area behind the notification/status bar -->
        <View
            android:id="@+id/statusBarBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/sage_dark" />

        <!-- Center the form in the remaining screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/cream">

            <TextView
                android:id="@+id/addEditTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Pantry Item"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/brown"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <EditText
                android:id="@+id/ingredientNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ingredient name"
                android:textColor="@color/brown"
                android:textColorHint="@color/brown_light"
                android:inputType="text"
                android:importantForAutofill="no"
                android:backgroundTint="@color/sage"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/ingredientQuantityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quantity"
                android:textColor="@color/brown"
                android:textColorHint="@color/brown_light"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"
                android:backgroundTint="@color/sage"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/ingredientUnitInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Unit (e.g. kg, g, L, items)"
                android:textColor="@color/brown"
                android:textColorHint="@color/brown_light"
                android:inputType="text"
                android:importantForAutofill="no"
                android:backgroundTint="@color/sage"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/expiryDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Expiry date (optional)"
                android:textColor="@color/brown"
                android:textColorHint="@color/brown_light"
                android:focusable="false"
                android:clickable="true"
                android:backgroundTint="@color/sage"
                android:padding="12dp"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/saveIngredientButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Ingredient"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/sage"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/sage_dark" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>