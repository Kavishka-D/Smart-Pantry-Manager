<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".SettingsActivity">

    <!-- Main Settings & Profile screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cream">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:background="@color/sage"
            android:titleTextColor="@color/white" />

        <!-- Fixed dark sage area behind the notification/status bar -->
        <View
            android:id="@+id/statusBarBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/sage_dark" />

        <!-- Scrollable settings content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/cream"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:background="@color/cream">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings &amp; Profile"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/brown"
                    android:gravity="center"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="28dp" />

                <ImageView
                    android:id="@+id/settingsProfileImage"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:background="@drawable/circle_profile"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Profile picture"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/changePhotoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Profile Picture"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/sage"
                    android:layout_marginBottom="28dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preferences"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/brown"
                    android:layout_marginBottom="8dp" />

                <Switch
                    android:id="@+id/expiryAlertSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expiring-soon alerts"
                    android:textSize="18sp"
                    android:textColor="@color/brown"
                    android:layout_marginBottom="28dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profile Information"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/brown"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/settingsNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your name"
                    android:textColor="@color/brown"
                    android:textColorHint="@color/brown_light"
                    android:inputType="textPersonName"
                    android:importantForAutofill="no"
                    android:backgroundTint="@color/sage"
                    android:padding="12dp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/saveProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Profile"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/sage"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/backToHomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Home"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/sage_dark"
                    android:layout_marginBottom="35dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/cream"
        app:itemTextColor="@color/brown"
        app:itemIconTint="@color/sage"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>